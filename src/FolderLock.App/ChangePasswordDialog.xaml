<ui:FluentWindow x:Class="FolderLock.App.ChangePasswordDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:FolderLock.App"
                 Title="{local:Loc Dialog.ChangePassword}"
                 Width="440"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{local:Loc Dialog.ChangePassword}" />

        <StackPanel Grid.Row="1" Margin="24,6,24,22">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{local:Loc Dialog.CurrentPassword}" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:PasswordBox x:Name="CurrentInput" />

            <TextBlock Text="{local:Loc Dialog.NewPassword}" FontSize="12" Margin="0,12,0,4"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:PasswordBox x:Name="NewInput" PasswordChanged="NewInput_PasswordChanged" />
            <ProgressBar x:Name="StrengthBar" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="4" Value="0" />
            <TextBlock x:Name="StrengthText" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{local:Loc Dialog.ConfirmNewPassword}" FontSize="12" Margin="0,12,0,4"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:PasswordBox x:Name="ConfirmInput" />

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,12,0,0" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <ui:Button Content="{local:Loc Dialog.Cancel}" Width="88" Margin="0,0,8,0" IsCancel="True" />
                <ui:Button Content="{local:Loc Dialog.Ok}" Width="88" Appearance="Primary" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
