<ui:FluentWindow x:Class="FolderLock.App.LogsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:FolderLock.App"
                 Title="{local:Loc Log.Title}"
                 Height="620"
                 Width="900"
                 MinHeight="420"
                 MinWidth="680"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{local:Loc Log.Title}" />

        <DataGrid x:Name="LogGrid"
                  Grid.Row="1"
                  Margin="16,10,16,0"
                  Background="Transparent"
                  BorderThickness="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{local:Loc Log.Time}" Binding="{Binding Time}" Width="150" />
                <DataGridTextColumn Header="{local:Loc Log.Action}" Binding="{Binding Action}" Width="90" />
                <DataGridTemplateColumn Header="{local:Loc Log.Result}" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Result}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{local:Loc Log.Folder}" Binding="{Binding Folder}" Width="*" />
                <DataGridTextColumn Header="{local:Loc Log.Detail}" Binding="{Binding Detail}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12">
            <ui:Button Content="{local:Loc Log.Refresh}" Click="Refresh_Click" Margin="0,0,8,0" />
            <ui:Button Content="{local:Loc Log.Export}" Click="Export_Click" Margin="0,0,8,0" />
            <ui:Button Content="{local:Loc Log.Clear}" Click="Clear_Click" Margin="0,0,8,0" />
            <ui:Button Content="{local:Loc Log.Close}" Appearance="Primary" Click="Close_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
