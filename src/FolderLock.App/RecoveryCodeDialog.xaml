<ui:FluentWindow x:Class="FolderLock.App.RecoveryCodeDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:FolderLock.App"
                 Title="{local:Loc Recovery.Title}"
                 Width="480"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{local:Loc Recovery.Title}" />

        <StackPanel Grid.Row="1" Margin="24,6,24,22">
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{local:Loc Recovery.Desc}" />

            <ui:Card Margin="0,14,0,0" Padding="16,14">
                <TextBlock x:Name="CodeText"
                           FontFamily="Consolas"
                           FontSize="20"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </ui:Card>

            <TextBlock x:Name="CopyHint"
                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                       Visibility="Collapsed"
                       Margin="0,10,0,0"
                       Text="{local:Loc Recovery.Copied}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <ui:Button Content="{local:Loc Dialog.Copy}" Width="88" Margin="0,0,8,0" Click="Copy_Click" />
                <ui:Button Content="{local:Loc Dialog.Saved}" Width="110" Appearance="Primary" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
