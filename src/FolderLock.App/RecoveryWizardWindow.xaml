<ui:FluentWindow x:Class="FolderLock.App.RecoveryWizardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:FolderLock.App"
                 Title="{local:Loc Recovery.WizardTitle}"
                 Width="520"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{local:Loc Recovery.WizardTitle}" />

        <StackPanel Grid.Row="1" Margin="24,6,24,22">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ListBox x:Name="ChannelList"
                     Height="150"
                     Margin="0,14,0,0"
                     DisplayMemberPath="Display"
                     SelectionChanged="ChannelList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding Available}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock x:Name="ChannelReason"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel x:Name="SecretPanel" Margin="0,12,0,0">
                <TextBlock Text="{local:Loc Dialog.Password}" FontSize="12" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:PasswordBox x:Name="SecretInput" />
            </StackPanel>

            <ui:Button x:Name="VerifyButton"
                       Content="{local:Loc Recovery.VerifyChannel}"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Left"
                       Appearance="Primary"
                       Click="Verify_Click" />

            <TextBlock x:Name="ResultText"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel x:Name="NewPasswordPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock Text="{local:Loc Recovery.NewPasswordTitle}" FontWeight="SemiBold" />
                <TextBlock Text="{local:Loc Recovery.NewPasswordDesc}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Margin="0,4,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Text="{local:Loc Dialog.NewPassword}" FontSize="12" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:PasswordBox x:Name="NewPasswordInput" />

                <TextBlock Text="{local:Loc Dialog.ConfirmNewPassword}" FontSize="12" Margin="0,10,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:PasswordBox x:Name="ConfirmPasswordInput" />

                <ui:Button Content="{local:Loc Recovery.NewPasswordTitle}"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Left"
                           Appearance="Primary"
                           Click="Save_Click" />
            </StackPanel>

            <TextBlock Text="{local:Loc Recovery.Irrecoverable}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Margin="0,16,0,0"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />

            <ui:Button Content="{local:Loc Dialog.Cancel}"
                       Width="88"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Right"
                       IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
